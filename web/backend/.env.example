# --- API Gateway y Orígenes CORS Permitidos (#127) ---
PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Direcciones Internas de Microservicios (#127) ---
AUTH_SERVICE_URL=http://localhost:3001
INCIDENTES_SERVICE_URL=http://localhost:3002
NOTIFICACIONES_SERVICE_URL=http://localhost:3003

# --- Seguridad JWT (Reemplazar en .env local, nunca versionar secretos reales) ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Bases de Datos PostgreSQL Locales (Docker Compose) ---
DATABASE_URL_AUTH=postgresql://auth_user:replace-password@localhost:5432/auth_usuarios?schema=public
DATABASE_URL_INCIDENTES=postgresql://incidentes_user:replace-password@localhost:5433/incidentes?schema=public
DATABASE_URL_NOTIFICACIONES=postgresql://notificaciones_user:replace-password@localhost:5434/notificaciones?schema=public

# --- Supabase Storage (Object Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_EVIDENCES=incident-evidences
