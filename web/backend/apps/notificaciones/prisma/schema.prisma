generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Notificacion {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid     // FK externa: auth-usuarios
  incidenteId  String   @map("incidente_id") @db.Uuid   // FK externa: incidentes
  mensaje      String
  leido        Boolean  @default(false)
  fecha        DateTime @default(now())
  @@map("notificacion")
}