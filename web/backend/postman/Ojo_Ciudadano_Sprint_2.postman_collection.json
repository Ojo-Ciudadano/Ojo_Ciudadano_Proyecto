{
  "info": {
    "name": "Ojo Ciudadano - Sprint 2",
    "description": "Colección versionada de Postman para ejercitar las operaciones principales del backend de Sprint 2 a través del API Gateway (/api/v1), incluyendo autenticación, incidentes, transiciones de estado (#116, #117), evidencias (#86), notificaciones (#113, #114), cambio de rol (#122) y casos 401/403 (#100).\n\nIMPORTANTE: Para ejecutar contra el entorno remoto en Kubernetes UCT, desactivar obligatoriamente 'SSL certificate verification' (OFF) en Postman Settings -> General.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth & Sesión",
      "item": [
        {
          "name": "1.1 Login Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Respuesta incluye access_token, token_type Bearer y datos de usuario ADMIN', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token').that.is.a('string').and.is.not.empty;",
                  "    pm.expect(jsonData).to.have.property('token_type', 'Bearer');",
                  "    pm.expect(jsonData).to.have.property('usuario').that.is.an('object');",
                  "    pm.expect(jsonData.usuario).to.have.property('id').that.is.a('string');",
                  "    pm.expect(jsonData.usuario).to.have.property('email', pm.environment.get('adminEmail'));",
                  "    pm.expect(jsonData.usuario.roles).to.be.an('array').that.includes('ADMIN');",
                  "});",
                  "pm.environment.set('adminToken', jsonData.access_token);",
                  "pm.environment.set('adminId', jsonData.usuario.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login Ciudadano (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Respuesta incluye access_token, token_type Bearer y datos de usuario CIUDADANO', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token').that.is.a('string').and.is.not.empty;",
                  "    pm.expect(jsonData).to.have.property('token_type', 'Bearer');",
                  "    pm.expect(jsonData).to.have.property('usuario').that.is.an('object');",
                  "    pm.expect(jsonData.usuario).to.have.property('id').that.is.a('string');",
                  "    pm.expect(jsonData.usuario).to.have.property('email', pm.environment.get('ciudadanoEmail'));",
                  "    pm.expect(jsonData.usuario.roles).to.be.an('array').that.includes('CIUDADANO');",
                  "});",
                  "pm.environment.set('ciudadanoToken', jsonData.access_token);",
                  "pm.environment.set('ciudadanoId', jsonData.usuario.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ciudadanoEmail}}\",\n  \"password\": \"{{ciudadanoPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Consultar Perfil Propio Ciudadano (/usuarios/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Perfil contiene campos esenciales sin exponer passwordHash', function () {",
                  "    pm.expect(jsonData).to.have.property('id', pm.environment.get('ciudadanoId'));",
                  "    pm.expect(jsonData).to.have.property('email', pm.environment.get('ciudadanoEmail'));",
                  "    pm.expect(jsonData.roles).to.be.an('array').that.includes('CIUDADANO');",
                  "    pm.expect(jsonData).to.not.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/me",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Incidentes & Transiciones de Estado",
      "item": [
        {
          "name": "2.1 Obtener Categorías y Guardar categoriaId (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Catálogo de categorías no está vacío y contiene campos esenciales', function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(jsonData[0]).to.have.property('id').that.is.a('string');",
                  "    pm.expect(jsonData[0]).to.have.property('nombre').that.is.a('string');",
                  "    pm.expect(jsonData[0]).to.have.property('prioridadBase').that.is.a('number');",
                  "});",
                  "if (jsonData.length > 0) {",
                  "    pm.environment.set('categoriaId', jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"]
            }
          }
        },
        {
          "name": "2.2 Crear Incidente como Ciudadano (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Incidente creado en estado Nuevo con campos esenciales', function () {",
                  "    pm.expect(jsonData).to.have.property('id').that.is.a('string');",
                  "    pm.expect(jsonData).to.have.property('titulo', 'Luminaria apagada en Av. Alemania');",
                  "    pm.expect(jsonData).to.have.property('categoriaId', pm.environment.get('categoriaId'));",
                  "    pm.expect(jsonData).to.have.property('usuarioReportaId', pm.environment.get('ciudadanoId'));",
                  "    pm.expect(jsonData).to.have.property('nivelPrioridad').that.is.a('number');",
                  "    pm.expect(jsonData).to.have.property('estado').that.is.an('object');",
                  "    pm.expect(jsonData.estado).to.have.property('nombre', 'Nuevo');",
                  "    pm.expect(jsonData).to.have.property('evidencias').that.is.an('array');",
                  "});",
                  "pm.environment.set('incidenteId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Luminaria apagada en Av. Alemania\",\n  \"descripcion\": \"El poste de alumbrado público ubicado frente al campus se encuentra apagado desde hace dos noches.\",\n  \"categoriaId\": \"{{categoriaId}}\",\n  \"usuarioReportaId\": \"{{ciudadanoId}}\",\n  \"ubicacion\": {\n    \"latitud\": -38.7359,\n    \"longitud\": -72.5904,\n    \"direccionReferencia\": \"Av. Alemania 0422\",\n    \"comuna\": \"Temuco\",\n    \"region\": \"La Araucanía\",\n    \"sector\": \"Poniente\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes"]
            }
          }
        },
        {
          "name": "2.3 Cambiar Estado - Transición Permitida Nuevo -> En revisión (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Estado del incidente se actualiza a En revisión', function () {",
                  "    pm.expect(jsonData).to.have.property('id', pm.environment.get('incidenteId'));",
                  "    pm.expect(jsonData).to.have.property('estado').that.is.an('object');",
                  "    pm.expect(jsonData.estado).to.have.property('nombre', 'En revisión');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"En revisión\",\n  \"observacion\": \"Se inicia la evaluación técnica del reporte en terreno\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidentes/{{incidenteId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes", "{{incidenteId}}", "estado"]
            }
          }
        },
        {
          "name": "2.4 Cambiar Estado - Transición Prohibida En revisión -> Resuelto (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Respuesta de error cumple ErrorResponseFormat (#116)', function () {",
                  "    pm.expect(jsonData).to.have.property('statusCode', 409);",
                  "    pm.expect(jsonData).to.have.property('error', 'Conflict');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('path');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Resuelto\",\n  \"observacion\": \"Intento de transición prohibida saltando En atención\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidentes/{{incidenteId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes", "{{incidenteId}}", "estado"]
            }
          }
        },
        {
          "name": "2.5 Consultar Historial del Incidente (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Historial registra estado inicial y transición a En revisión', function () {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.at.least(2);",
                  "    const ultimo = jsonData[jsonData.length - 1];",
                  "    pm.expect(ultimo).to.have.property('incidenteId', pm.environment.get('incidenteId'));",
                  "    pm.expect(ultimo.estado).to.have.property('nombre', 'En revisión');",
                  "    pm.expect(ultimo).to.have.property('usuarioId', pm.environment.get('adminId'));",
                  "    pm.expect(ultimo).to.have.property('observacion', 'Se inicia la evaluación técnica del reporte en terreno');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/{{incidenteId}}/historial",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes", "{{incidenteId}}", "historial"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Evidencias (#86)",
      "item": [
        {
          "name": "3.1 Subir Evidencia Asociada al Incidente (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Metadata de evidencia incluye campos esenciales sin exponer claveArchivo', function () {",
                  "    pm.expect(jsonData).to.have.property('id').that.is.a('string');",
                  "    pm.expect(jsonData).to.have.property('incidenteId', pm.environment.get('incidenteId'));",
                  "    pm.expect(jsonData).to.have.property('tipoMime').that.is.oneOf(['image/jpeg', 'image/png', 'image/webp']);",
                  "    pm.expect(jsonData).to.have.property('tamanoArchivo').that.is.a('number').and.is.above(0);",
                  "    pm.expect(jsonData).to.have.property('fechaCreacion').that.is.a('string');",
                  "    pm.expect(jsonData).to.have.property('url', `/evidencias/${jsonData.id}/archivo`);",
                  "    pm.expect(jsonData).to.not.have.property('claveArchivo');",
                  "});",
                  "pm.environment.set('evidenciaId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivo",
                  "description": "Seleccionar una imagen local (JPEG, PNG o WebP <= 10 MB) antes de ejecutar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/incidentes/{{incidenteId}}/evidencias",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes", "{{incidenteId}}", "evidencias"]
            }
          }
        },
        {
          "name": "3.2 Consultar Evidencias del Incidente (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Listado de evidencias contiene la evidencia subida', function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "    const ev = jsonData.find(item => item.id === pm.environment.get('evidenciaId'));",
                  "    pm.expect(ev).to.not.be.undefined;",
                  "    pm.expect(ev).to.have.property('incidenteId', pm.environment.get('incidenteId'));",
                  "    pm.expect(ev).to.have.property('url').that.includes('/evidencias/');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/{{incidenteId}}/evidencias",
              "host": ["{{baseUrl}}"],
              "path": ["incidentes", "{{incidenteId}}", "evidencias"]
            }
          }
        },
        {
          "name": "3.3 Consultar Metadata de Evidencia Individual (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Metadata coincide con la evidencia creada', function () {",
                  "    pm.expect(jsonData).to.have.property('id', pm.environment.get('evidenciaId'));",
                  "    pm.expect(jsonData).to.have.property('incidenteId', pm.environment.get('incidenteId'));",
                  "    pm.expect(jsonData).to.have.property('tipoMime');",
                  "    pm.expect(jsonData).to.have.property('tamanoArchivo');",
                  "    pm.expect(jsonData).to.have.property('url');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/evidencias/{{evidenciaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evidencias", "{{evidenciaId}}"]
            }
          }
        },
        {
          "name": "3.4 Recuperar Archivo Binario de Evidencia (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Cabeceras binarias incluyen Content-Type de imagen permitido', function () {",
                  "    const contentType = pm.response.headers.get('Content-Type');",
                  "    pm.expect(contentType).to.match(/^image\\/(jpeg|png|webp)/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/evidencias/{{evidenciaId}}/archivo",
              "host": ["{{baseUrl}}"],
              "path": ["evidencias", "{{evidenciaId}}", "archivo"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Notificaciones (#113, #114)",
      "item": [
        {
          "name": "4.1 Consultar Notificaciones Propias tras Cambio Relevante (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Existe notificación generada para el ciudadano tras el cambio de estado del incidente', function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "    const notif = jsonData.find(n => n.incidenteId === pm.environment.get('incidenteId'));",
                  "    pm.expect(notif).to.not.be.undefined;",
                  "    pm.expect(notif).to.have.property('id').that.is.a('string');",
                  "    pm.expect(notif).to.have.property('usuarioId', pm.environment.get('ciudadanoId'));",
                  "    pm.expect(notif).to.have.property('incidenteId', pm.environment.get('incidenteId'));",
                  "    pm.expect(notif).to.have.property('mensaje').that.includes('En revisión');",
                  "    pm.expect(notif).to.have.property('leido').that.is.a('boolean');",
                  "    pm.expect(notif).to.have.property('fecha').that.is.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{ciudadanoToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notificaciones",
              "host": ["{{baseUrl}}"],
              "path": ["notificaciones"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Gestión de Roles de Usuario (#122)",
      "item": [
        {
          "name": "5.1 Cambiar Rol de Usuario a ADMIN como Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Respuesta confirma asignación del rol ADMIN al usuario objetivo', function () {",
                  "    pm.expect(jsonData).to.have.property('id', pm.environment.get('usuarioObjetivoId'));",
                  "    pm.expect(jsonData.roles).to.be.an('array').that.includes('ADMIN');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuarioObjetivoId}}/rol",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{usuarioObjetivoId}}", "rol"]
            }
          }
        },
        {
          "name": "5.2 Restaurar Rol de Usuario a CIUDADANO como Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
