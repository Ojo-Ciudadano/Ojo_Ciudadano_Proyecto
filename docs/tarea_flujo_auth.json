        {
          "name": "Authorization",
          "value": "Bearer <TOKEN_CIUDADANO>"
        }
      ]
    },
    {
      "name": "3. Acceso Permitido Admin (200)",
      "url": "http://localhost:3000/auth/admin-only",
      "method": "GET",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer <TOKEN_ADMIN>"
        }
      ]
    }
  ]
