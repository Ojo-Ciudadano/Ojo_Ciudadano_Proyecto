<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">ojociudadano.dev.censei.cl</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/uct_ingress_cert" />
        </trust-anchors>
    </domain-config>

    <!-- Excepción temporal de desarrollo, limitada a los certificados observados de esta API. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api-ojociudadano.dev.censei.cl</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/debug_ingress_a" />
            <certificates src="@raw/debug_ingress_b" />
        </trust-anchors>
    </domain-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
